MCP_API_KEY=changeme-long-random
BASE_URL=https://crm.example.com
DB_DSN=crmagents_user_bf2722:PASSWORD@tcp(localhost:3306)/crmagents?parseTime=true&multiStatements=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
PORT=8080
SCHEDULER_INTERVAL_SEC=15
EXPORT_DIR=/data/exports
LOG_LEVEL=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL_SEC=60
IMAP_SINCE_DAYS=14
ADMIN_NOTIFY_EMAIL=
EMAIL_RATE_MAX=
EMAIL_RATE_WINDOW_SEC=
VERIFY_EMAILS=false
BLOCK_INVALID_SEND=false

# --- Threads channel (hybrid live API + MySQL cache/audit) ---
# Enabled when THREADS_ACCESS_TOKEN is set. Never commit real token.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=me
THREADS_API_VERSION=v1.0

# --- WhatsApp channel (two-way) ---
# Enabled when WA_BASE_URL and WA_DEVICE_ID are both set.
# Gateway: go-whatsapp-web-multidevice. Leave blank to disable WhatsApp.
WA_BASE_URL=
WA_BASIC_AUTH=
WA_DEVICE_ID=cds
# HMAC-SHA256 secret to validate inbound gateway webhooks (empty = no validation; NOT recommended in prod)
WA_WEBHOOK_SECRET=
# Smart-send / ban-prevention (all 0 = no throttle; recommended on for real numbers)
WA_SEND_MAX=
WA_SEND_WINDOW_SEC=
WA_SEND_DAILY_CAP=
WA_SEND_JITTER_MIN_MS=
WA_SEND_JITTER_MAX_MS=
WA_WARMUP_PER_DAY=
# Refuse sends to numbers verified NOT on WhatsApp
WA_BLOCK_UNREGISTERED_SEND=false
